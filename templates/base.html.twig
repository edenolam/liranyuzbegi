<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'he' ? 'rtl' : 'ltr' }}">
<head>
    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set currentParams = app.request.attributes.get('_route_params')|default({}) %}
    {% set localizedRoutes = {
        'home': 'localized_home',
        'localized_home': 'localized_home',
        'about': 'localized_about',
        'localized_about': 'localized_about',
        'app_song_list': 'localized_song_list',
        'localized_song_list': 'localized_song_list',
        'app_song_show': 'localized_song_show',
        'localized_song_show': 'localized_song_show',
        'contact': 'localized_contact',
        'localized_contact': 'localized_contact'
    } %}
    {% set seoRoute = localizedRoutes[currentRoute]|default(null) %}
    {% set seoParams = currentParams|merge({'_locale': app.request.locale}) %}
    {% set seoDescription %}{% block meta_description %}{{ 'seo.default_description'|trans }}{% endblock %}{% endset %}

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'songs'|trans }}{% endblock %}</title>
    <meta name="description" content="{{ seoDescription|striptags|trim }}">
    <meta name="author" content="Liran Yuzbegi">
    <meta name="robots" content="{{ currentRoute starts with 'app_admin_' or currentRoute in ['app_login', 'app_logout'] ? 'noindex, nofollow' : 'index, follow, max-image-preview:large' }}">

    {% if seoRoute %}
        <link rel="canonical" href="{{ absolute_url(path(seoRoute, seoParams)) }}">
        <link rel="alternate" hreflang="he" href="{{ absolute_url(path(seoRoute, seoParams|merge({'_locale': 'he'}))) }}">
        <link rel="alternate" hreflang="en" href="{{ absolute_url(path(seoRoute, seoParams|merge({'_locale': 'en'}))) }}">
        <link rel="alternate" hreflang="x-default" href="{{ absolute_url(path(seoRoute, seoParams|merge({'_locale': 'he'}))) }}">
    {% endif %}

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Liran Yuzbegi · לירן יוזבגי">
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:description" content="{{ seoDescription|striptags|trim }}">
    <meta property="og:locale" content="{{ app.request.locale == 'he' ? 'he_IL' : 'en_US' }}">
    {% if seoRoute %}
        <meta property="og:url" content="{{ absolute_url(path(seoRoute, seoParams)) }}">
    {% endif %}
    <meta name="twitter:card" content="summary">

    {% set personSchema = {
        '@context': 'https://schema.org',
        '@type': 'Person',
        '@id': absolute_url(path('localized_about', {'_locale': app.request.locale})) ~ '#liran-yuzbegi',
        'name': 'Liran Yuzbegi',
        'alternateName': ['לירן יוזבגי', 'Liran Yuzbegi'],
        'url': absolute_url(path('localized_about', {'_locale': app.request.locale})),
        'description': 'seo.person_description'|trans,
        'jobTitle': 'seo.person_job_title'|trans,
        'knowsAbout': ['Sound art', 'Music composition', 'Experimental film', 'Contemporary art', 'Slow cinema', 'Curatorial studies']
    } %}
    <script type="application/ld+json">{{ personSchema|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block stylesheets %}{% endblock %}
    {{ importmap('app') }}
</head>

<body>
<a class="skip-link" href="#main-content">{{ 'accessibility.skip_to_content'|trans }}</a>

<nav class="navbar navbar-expand-lg navbar-dark site-navbar" aria-label="{{ 'accessibility.main_navigation'|trans }}">
    <div class="container">
        <a class="navbar-brand" href="{{ path('localized_home', {'_locale': app.request.locale}) }}">לירן יוזבגי</a>
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="{{ 'accessibility.toggle_navigation'|trans }}"
        >
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('localized_home', {'_locale': app.request.locale}) }}">{{ 'home'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('localized_song_list', {'_locale': app.request.locale}) }}">{{ 'songs'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('localized_about', {'_locale': app.request.locale}) }}">{{ 'about'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('localized_contact', {'_locale': app.request.locale}) }}">{{ 'contact'|trans }}</a>
                </li>
            </ul>
            <div class="dropdown ms-3">
                <button
                    class="btn btn-secondary dropdown-toggle"
                    type="button"
                    id="languageDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                >
                    <span aria-hidden="true">🌍</span>
                    <span class="visually-hidden">{{ 'accessibility.language_selection'|trans }}:</span>
                    {{ app.request.locale|upper }}
                </button>
                <ul class="dropdown-menu" aria-labelledby="languageDropdown">
                    {% if seoRoute %}
                        <li><a class="dropdown-item" lang="he" dir="rtl" hreflang="he" href="{{ path(seoRoute, seoParams|merge({'_locale': 'he'})) }}">🇮🇱 עברית</a></li>
                        <li><a class="dropdown-item" lang="en" dir="ltr" hreflang="en" href="{{ path(seoRoute, seoParams|merge({'_locale': 'en'})) }}">🇬🇧 English</a></li>
                    {% else %}
                        <li><a class="dropdown-item" lang="he" dir="rtl" href="{{ path('change_locale', {'locale': 'he'}) }}">🇮🇱 עברית</a></li>
                        <li><a class="dropdown-item" lang="en" dir="ltr" href="{{ path('change_locale', {'locale': 'en'}) }}">🇬🇧 English</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="d-flex flex-column min-vh-100">
    <main id="main-content" class="container mt-5 flex-grow-1" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__main">
                <div>
                    <span class="site-footer__mark">{{ 'footer_identity'|trans }}</span>
                    <p class="site-footer__name" lang="he" dir="rtl">לירן יוזבגי</p>
                    <p class="site-footer__tagline">{{ 'footer_tagline'|trans }}</p>
                </div>

                <nav aria-label="{{ 'footer_explore'|trans }}">
                    <h2 class="site-footer__heading">{{ 'footer_explore'|trans }}</h2>
                    <ul class="site-footer__links">
                        <li><a href="{{ path('localized_home', {'_locale': app.request.locale}) }}">{{ 'home'|trans }}</a></li>
                        <li><a href="{{ path('localized_song_list', {'_locale': app.request.locale}) }}">{{ 'songs'|trans }}</a></li>
                        <li><a href="{{ path('localized_about', {'_locale': app.request.locale}) }}">{{ 'about'|trans }}</a></li>
                    </ul>
                </nav>

                <div class="site-footer__contact">
                    <h2 class="site-footer__heading">{{ 'contact'|trans }}</h2>
                    <p>{{ 'footer_contact_text'|trans }}</p>
                    <a class="btn btn-outline-secondary" href="{{ path('localized_contact', {'_locale': app.request.locale}) }}">
                        {{ 'footer_contact_cta'|trans }}
                    </a>
                </div>
            </div>

            <div class="site-footer__bottom">
                <p>© {{ 'now'|date('Y') }} Liran Yuzbegi. {{ 'footer_rights'|trans }}</p>
                <p>{{ 'footer_location'|trans }}</p>
            </div>
        </div>
    </footer>
</div>
</body>
</html>

{% extends 'portfolio_base.html.twig' %}

{% block title %}Music | Liran Yuzbegi{% endblock %}
{% block description %}Music, electroacoustic compositions and sound works by Liran Yuzbegi.{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
<section class="portfolio-music">
    <header class="portfolio-music__header">
        <p>Selected works</p>
        <h1>Music</h1>
        <span class="portfolio-rule"></span>
    </header>

    <div class="portfolio-music__grid">
        {% for song in songs %}
            <article class="music-work">
                <div class="music-work__cover">
                    <img src="{{ song.coverImage ? asset('uploads/covers/' ~ song.coverImage) : asset('defaultcoverimage.svg') }}" alt="Cover artwork for {{ song.title }}">
                </div>
                <div class="music-work__body">
                    <p class="music-work__number">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</p>
                    <h2>{{ song.title }}</h2>
                    <p>{{ song.artist }}{% if song.album %} · {{ song.album }}{% endif %}{% if song.year %} · {{ song.year }}{% endif %}</p>
                    {% if song.audioFile %}
                        <audio id="audio-{{ loop.index }}" preload="metadata" src="{{ asset('uploads/songs/' ~ song.audioFile) }}"></audio>
                        <div class="music-work__controls">
                            <button type="button" data-audio-action="play" data-audio-index="{{ loop.index }}" aria-label="Play {{ song.title }}">Play</button>
                            <button type="button" data-audio-action="pause" data-audio-index="{{ loop.index }}" aria-label="Pause {{ song.title }}">Pause</button>
                            <button type="button" data-audio-action="stop" data-audio-index="{{ loop.index }}" aria-label="Stop {{ song.title }}">Stop</button>
                        </div>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p class="portfolio-music__empty">No works are available yet.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}

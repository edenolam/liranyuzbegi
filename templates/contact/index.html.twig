{% extends 'portfolio_base.html.twig' %}
{% block title %}Contact | Liran Yuzbegi{% endblock %}
{% block description %}Contact Liran Yuzbegi regarding artistic projects, research, screenings, exhibitions and collaborations.{% endblock %}
{% block body %}
<section class="portfolio-contact">
    <div class="portfolio-contact__copy">
        <h1>Contact</h1>
        <span class="portfolio-rule"></span>
        <p class="portfolio-contact__label">Email</p>
        <a class="portfolio-contact__email" href="mailto:contact@liranyuzbegi.com">contact@liranyuzbegi.com</a>
        {% for message in app.flashes('success') %}<div class="portfolio-success">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="portfolio-error">{{ message }}</div>{% endfor %}
        <details class="portfolio-form-toggle">
            <summary>Send a message</summary>
            <div class="portfolio-form">
                {{ form_start(contactForm) }}
                <div>{{ form_label(contactForm.name, 'Name') }}{{ form_widget(contactForm.name) }}{{ form_errors(contactForm.name) }}</div>
                <div>{{ form_label(contactForm.email, 'Email') }}{{ form_widget(contactForm.email) }}{{ form_errors(contactForm.email) }}</div>
                <div>{{ form_label(contactForm.message, 'Message') }}{{ form_widget(contactForm.message) }}{{ form_errors(contactForm.message) }}</div>
                {{ form_widget(contactForm.submit, {'label': 'Send'}) }}
                {{ form_end(contactForm) }}
            </div>
        </details>
    </div>
</section>
{% endblock %}

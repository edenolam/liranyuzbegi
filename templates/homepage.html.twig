{% extends 'portfolio_base.html.twig' %}
{% block title %}Liran Yuzbegi | Researcher, Composer & Experimental Filmmaker{% endblock %}
{% block description %}Research and artistic practice by Liran Yuzbegi exploring music, audiovisual form, slowness in cinema, loss, grief and institutional spaces of care.{% endblock %}
{% block body %}
    <section class="portfolio-hero">
        <div class="portfolio-hero__copy">
            <h1>Dr Liran Yuzbegi</h1>
            <p class="portfolio-roles">Researcher, artist and composer.</p>
            <span class="portfolio-rule"></span>
            <p class="portfolio-summary">Exploring slowness in electroacoustic music, visual arts, and cinema, alongside representations of
                loss, grief, and institutional spaces of care.</p>
        </div>
    </section>
{% endblock %}

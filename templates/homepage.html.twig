{% extends 'base.html.twig' %}

{% block title %}{{ 'seo.home_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'seo.home_description'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-5" dir="{{ app.request.locale == 'he' ? 'rtl' : 'ltr' }}">
        <h2 class="text-center fw-bold">{{ 'latest_songs'|trans }}</h2>
        <div class="row row-cols-1 row-cols-md-4 g-4 mt-4">
            {% for song in latestSongs %}
                <div class="col">
                    <div class="card shadow-lg h-100">
                        <img src="{{ song.coverImage ? asset('uploads/covers/' ~ song.coverImage) : asset('defaultcoverimage.svg') }}"
                                class="card-img-top"
                                alt="{{ song.title }}"
                                style="height: 250px; object-fit: cover;">

                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold">{{ song.title }}</h5>
                            <p class="card-text">{{ 'artist'|trans }} : {{ song.artist }}</p>
                            {% if song.album %}
                                <p class="card-text">{{ 'album'|trans }} : {{ song.album }}</p>
                            {% endif %}
                        </div>
                        {% if song.audioFile %}
                            <div class="card-footer text-center ltr-block">
                                <audio id="audio-{{ loop.index }}" preload="metadata" src="{{ asset('uploads/songs/' ~ song.audioFile) }}"></audio>
                                <button type="button" class="btn btn-sm" data-audio-action="play" data-audio-index="{{ loop.index }}" aria-label="{{ 'audio_controls.play'|trans({'%title%': song.title}) }}">▶️</button>
                                <button type="button" class="btn btn-sm" data-audio-action="pause" data-audio-index="{{ loop.index }}" aria-label="{{ 'audio_controls.pause'|trans({'%title%': song.title}) }}">⏸️</button>
                                <button type="button" class="btn btn-sm" data-audio-action="stop" data-audio-index="{{ loop.index }}" aria-label="{{ 'audio_controls.stop'|trans({'%title%': song.title}) }}">⏹️</button>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p class="text-center text-muted">{{ 'no_songs'|trans }}</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}

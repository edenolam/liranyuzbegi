{% extends 'base.html.twig' %}

{% block title %}{{ 'about_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'seo.about_description'|trans }}{% endblock %}

{% block body %}
    <section class="about-profile">
        <header class="about-profile__header">
            <p class="about-profile__eyebrow">{{ 'about_eyebrow'|trans }}</p>
            <h1>{{ 'about_header'|trans }}</h1>
            <p class="about-profile__intro">{{ 'about_intro'|trans }}</p>
        </header>

        <div class="about-profile__grid">
            <article class="about-profile__section">
                <h2>{{ 'about_practice_title'|trans }}</h2>
                <p>{{ 'about_practice_text'|trans }}</p>
            </article>

            <article class="about-profile__section">
                <h2>{{ 'about_research_title'|trans }}</h2>
                <p>{{ 'about_research_text'|trans }}</p>
            </article>

            <article class="about-profile__section">
                <h2>{{ 'about_curatorial_title'|trans }}</h2>
                <p>{{ 'about_curatorial_text'|trans }}</p>
            </article>

            <article class="about-profile__section">
                <h2>{{ 'about_audiovisual_title'|trans }}</h2>
                <p>{{ 'about_audiovisual_text'|trans }}</p>
            </article>

            <article class="about-profile__section">
                <h2>{{ 'about_education_title'|trans }}</h2>
                <p>{{ 'about_education_text'|trans }}</p>
            </article>
        </div>

        <p class="about-profile__closing">{{ 'about_presented_text'|trans }}</p>
    </section>
{% endblock %}

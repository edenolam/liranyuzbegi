<form class="m-0" method="post" action="{{ path('app_admin_song_delete', {'id': song.id}) }}" onsubmit="return confirm({{ 'admin.actions.delete_confirm'|trans|json_encode }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ song.id) }}">
    <button class="btn btn-outline-secondary">{{ 'admin.actions.delete'|trans }}</button>
</form>

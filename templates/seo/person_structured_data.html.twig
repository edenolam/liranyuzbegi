{% set personId = 'https://liranyuzbegi.com/#liran-yuzbegi' %}
{% set websiteId = 'https://liranyuzbegi.com/#website' %}
{% set page = {
    '@type': isProfilePage ? 'ProfilePage' : 'WebPage',
    '@id': pageUrl ~ '#webpage',
    'url': pageUrl,
    'name': pageTitle,
    'inLanguage': 'en',
    'isPartOf': {'@id': websiteId},
    'about': {'@id': personId}
} %}
{% if isProfilePage %}
    {% set page = page|merge({'mainEntity': {'@id': personId}}) %}
{% endif %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': personId,
            'name': 'Liran Yuzbegi',
            'alternateName': 'לירן יוזבגי',
            'url': 'https://liranyuzbegi.com/',
            'sameAs': [
                'https://online.uni-graz.at/kfu_online/pl/ui/%24ctx%3Bdesign%3Dca2%3Bheader%3Dmax/visitenkarte.show_vcard?pPersonenGruppe=3&pPersonenId=7C2DB5B86E0AA36F',
                'https://open.spotify.com/artist/515MChdibJUMXGOKs0laMv'
            ],
            'mainEntityOfPage': {'@id': 'https://liranyuzbegi.com/about#webpage'},
            'image': 'https://liranyuzbegi.com/images/liran-yuzbegi-portrait.png',
            'jobTitle': 'Researcher, composer and experimental filmmaker',
            'knowsAbout': ['Electroacoustic music', 'Experimental film', 'Slow cinema', 'Audiovisual culture', 'Contemporary art']
        },
        {
            '@type': 'WebSite',
            '@id': websiteId,
            'url': 'https://liranyuzbegi.com/',
            'name': 'Liran Yuzbegi',
            'inLanguage': 'en',
            'publisher': {'@id': personId}
        },
        page
    ]
}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
